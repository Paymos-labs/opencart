{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-paymos" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <button type="button" id="button-paymos-reconcile" data-bs-toggle="tooltip" title="{{ button_reconcile }}" class="btn btn-info"><i class="fa-solid fa-rotate"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card mb-3" id="paymos-refunds">
      <div class="card-header">Paymos refunds</div>
      <div class="card-body">
        <form id="form-paymos-refund-order" class="d-flex gap-2 mb-3">
          <label for="paymos-refund-order">Order ID</label>
          <input id="paymos-refund-order" type="number" min="1" step="1" required class="form-control"/>
          <button type="submit" class="btn btn-info">Show</button>
        </form>
        <div id="paymos-refund-state" aria-live="polite"></div>
        <div id="paymos-refund-error" class="alert alert-danger" role="alert" hidden></div>
        <div id="paymos-refund-unavailable" class="alert alert-warning" role="status" hidden></div>
        <div id="paymos-refund-summary" class="mb-3"></div>
        <button type="button" data-refund-mode="full" class="btn btn-warning" disabled>Refund in full</button>
        <button type="button" data-refund-mode="overpayment" class="btn btn-warning" disabled>Refund overpayment</button>
        <table class="table mt-3"><thead><tr><th>Operation ID</th><th>Type</th><th>Status</th><th>Amount</th></tr></thead><tbody id="paymos-refund-history"></tbody></table>
      </div>
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-paymos" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_paymos_status" value="0"/>
                <input type="checkbox" name="payment_paymos_status" value="1" id="input-status" class="form-check-input"{% if payment_paymos_status %} checked{% endif %}/>
              </div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-mode" class="col-sm-2 col-form-label">{{ entry_mode }}</label>
            <div class="col-sm-10">
              <select name="payment_paymos_mode" id="input-mode" class="form-select">
                <option value="sandbox"{% if payment_paymos_mode == 'sandbox' %} selected{% endif %}>{{ text_sandbox }}</option>
                <option value="live"{% if payment_paymos_mode == 'live' %} selected{% endif %}>{{ text_live }}</option>
              </select>
              <div class="form-text">{{ help_mode }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_credentials }}</label>
            <div class="col-sm-10">
              <button type="button" id="button-paymos-connect" class="btn btn-primary mb-2">Connect Paymos</button>
              <div id="paymos-connect-status" class="form-text" aria-live="polite"></div>
              {% if generated_config %}
                <div class="alert alert-success mb-0">Connected securely</div>
              {% else %}
                <div class="alert alert-warning">Connect this store to Paymos.</div>
              {% endif %}
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-webhook-url" class="col-sm-2 col-form-label">{{ entry_webhook_url }}</label>
            <div class="col-sm-10">
              <input type="text" id="input-webhook-url" value="{{ webhook_url }}" class="form-control" readonly onclick="this.select();"/>
              <div class="form-text">{{ help_webhook_url }}</div>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-title" class="col-sm-2 col-form-label">{{ entry_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paymos_title" value="{{ payment_paymos_title }}" id="input-title" class="form-control"/>
            </div>
          </div>

          <div class="row mb-3">
            <label for="input-button-text" class="col-sm-2 col-form-label">{{ entry_button_text }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_paymos_button_text" value="{{ payment_paymos_button_text }}" id="input-button-text" class="form-control"/>
            </div>
          </div>

          {% set status_fields = {
            'payment_paymos_pending_status_id': entry_pending_status,
            'payment_paymos_confirming_status_id': entry_confirming_status,
            'payment_paymos_paid_status_id': entry_paid_status,
            'payment_paymos_failed_status_id': entry_failed_status,
            'payment_paymos_cancelled_status_id': entry_cancelled_status
          } %}
          {% for name, label in status_fields %}
            <div class="row mb-3">
              <label for="input-{{ name }}" class="col-sm-2 col-form-label">{{ label }}</label>
              <div class="col-sm-10">
                <select name="{{ name }}" id="input-{{ name }}" class="form-select">
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if attribute(_context, name) == order_status.order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          {% endfor %}

          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="number" name="payment_paymos_sort_order" value="{{ payment_paymos_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
<script>
(function () {
  var form = document.getElementById('form-paymos-refund-order');
  var order = document.getElementById('paymos-refund-order');
  var status = document.getElementById('paymos-refund-state');
  var errorBox = document.getElementById('paymos-refund-error');
  var unavailable = document.getElementById('paymos-refund-unavailable');
  var buttons = document.querySelectorAll('[data-refund-mode]');
  var currentOrder = '';
  var pending = {};
  var busy = false;
  function setBusy(value) {
    busy = value; order.disabled = value; form.querySelector('button').disabled = value;
  }
  function disable() { buttons.forEach(function (button) { button.disabled = true; }); }
  function clearError() { errorBox.textContent = ''; errorBox.hidden = true; status.textContent = ''; }
  function showError(message) {
    if (!errorBox.hidden) return;
    errorBox.textContent = message; errorBox.hidden = false; status.textContent = '';
  }
  function token(mode) {
    var key = 'paymos-refund:' + currentOrder + ':' + mode;
    var saved = window.localStorage.getItem(key);
    if (!saved) {
      var bytes = new Uint8Array(16);
      window.crypto.getRandomValues(bytes);
      saved = Array.from(bytes).map(function (value) { return value.toString(16).padStart(2, '0'); }).join('');
      window.localStorage.setItem(key, saved);
    }
    return saved;
  }
  function load() {
    disable();
    var requestedOrder = currentOrder;
    return fetch('{{ refund_panel|escape('js') }}&order_id=' + encodeURIComponent(requestedOrder))
      .then(function (response) { return response.json(); })
      .then(function (json) {
        if (requestedOrder !== currentOrder) return;
        if (json.error) { showError(json.error); return; }
        var data = json.success;
        var summary = data.summary;
        unavailable.textContent = data.unavailable_reason || '';
        unavailable.hidden = !data.unavailable_reason;
        pending = {};
        var history = document.getElementById('paymos-refund-history');
        history.textContent = '';
        data.operations.forEach(function (operation) {
          var row = document.createElement('tr');
          var observation = operation.observation || {};
          [operation.operation_id, operation.mode, operation.cash_state, (observation.amount || '') + ' ' + (observation.currency || '')].forEach(function (value) {
            var cell = document.createElement('td'); cell.textContent = value; row.appendChild(cell);
          });
          history.appendChild(row);
          var key = 'paymos-refund:' + currentOrder + ':' + operation.mode;
          if (operation.cash_state === 'unknown' || operation.cash_state === 'not_submitted') {
            pending[operation.mode] = operation.request_token;
          } else if (['failed', 'cancelled', 'completed'].indexOf(operation.cash_state) !== -1
            && window.localStorage.getItem(key) === operation.request_token) {
            window.localStorage.removeItem(key);
          }
        });
        document.getElementById('paymos-refund-summary').textContent =
          (summary.full_refund_amount || '0') + ' / ' + (summary.overpayment_refund_amount || '0')
          + ' ' + ((summary.refund_asset || {}).currency || '') + ' ' + (summary.sender_address || '');
        buttons.forEach(function (button) {
          var mode = button.dataset.refundMode;
          button.disabled = busy || data.unavailable_reason === 'refund_reconnect_required'
            || !(pending[mode] || (mode === 'full' ? data.can_full : data.can_overpayment));
        });
        status.textContent = errorBox.hidden ? 'Refund details loaded.' : '';
      }).catch(function () { if (requestedOrder !== currentOrder) return; disable(); showError('Refund details could not be loaded. Check the order ID and try again.'); });
  }
  form.addEventListener('submit', function (event) {
    event.preventDefault(); if (busy) return; clearError(); currentOrder = order.value; load();
  });
  buttons.forEach(function (button) {
    button.addEventListener('click', function () {
      if (busy) return;
      clearError();
      setBusy(true);
      disable();
      var mode = button.dataset.refundMode;
      try {
        var body = new URLSearchParams({mode: mode, request_token: pending[mode] || token(mode)});
        fetch('{{ refund_submit|escape('js') }}&order_id=' + encodeURIComponent(currentOrder), {
          method: 'POST', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: body.toString()
        }).then(function (response) { return response.json(); }).then(function (json) {
          setBusy(false);
          if (json.error) showError(json.error);
          return load();
        }).catch(function () { setBusy(false); showError('The refund request failed. Check the refunds below before trying again.'); load(); });
      } catch (error) { setBusy(false); showError('The refund request was not sent. Reload the page and try again.'); load(); }
    });
  });
}());
document.getElementById('button-paymos-reconcile').addEventListener('click', function () {
  fetch('{{ reconcile }}', {method: 'POST', headers: {'X-Requested-With': 'XMLHttpRequest'}})
    .then(function (response) { return response.json(); })
    .then(function (json) {
      if (json.error) {
        alert(json.error);
        return;
      }
      if (json.success) {
        alert(json.success);
      }
    });
});
document.getElementById('button-paymos-connect').addEventListener('click', function () {
  var button = this;
  var status = document.getElementById('paymos-connect-status');
  var manual = false;
  button.disabled = true;
  status.textContent = 'Starting secure connection…';
  // Opened synchronously: browsers only honour window.open for a few seconds after the
  // click, so opening it once the start request resolves is blocked on slow connections.
  // No feature string — any feature string asks for a popup, which blockers reject.
  var tab = window.open('', '_blank');
  if (tab) { try { tab.opener = null; } catch (error) {} }
  var body = new URLSearchParams({paymos_return_url: window.location.href});
  fetch('{{ connect_start }}', {method: 'POST', headers: {'X-Requested-With': 'XMLHttpRequest', 'Content-Type': 'application/x-www-form-urlencoded'}, body: body.toString()})
    .then(function (response) { return response.json(); })
    .then(function (json) {
      if (json.error) throw new Error(json.error);
      if (tab && !tab.closed) {
        tab.location = json.success.verification_url;
        status.textContent = 'Waiting for approval. Code: ' + json.success.user_code;
      } else {
        manual = true;
        status.textContent = '';
        var link = document.createElement('a');
        link.href = json.success.verification_url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Open the approval page';
        status.appendChild(document.createTextNode('Your browser blocked the approval tab. '));
        status.appendChild(link);
        status.appendChild(document.createTextNode(' Code: ' + json.success.user_code));
      }
      var interval = Math.max(1, Number(json.success.interval || 5)) * 1000;
      window.setTimeout(function poll() {
        fetch('{{ connect_poll }}', {method: 'POST', headers: {'X-Requested-With': 'XMLHttpRequest'}})
          .then(function (response) { return response.json(); })
          .then(function (result) {
            if (result.error) throw new Error(result.error);
            if (result.success.status === 'connected') { window.location.reload(); return; }
            window.setTimeout(poll, result.success.status === 'slow_down' ? interval + 5000 : interval);
          }).catch(function (error) {
            // Never clobber the manual approval link and code: they are the merchant's
            // only remaining way to finish once the tab was blocked.
            if (!manual) { status.textContent = error.message; }
            button.disabled = false;
          });
      }, interval);
    }).catch(function (error) {
      if (tab && !tab.closed) { tab.close(); }
      status.textContent = error.message;
      button.disabled = false;
    });
});
</script>
{{ footer }}
